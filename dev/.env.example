# Gravitee APIM version (use 'latest' for the latest version)
APIM_VERSION=latest

# Docker registry for Gravitee images
APIM_REGISTRY=graviteeio

# MongoDB version
MONGODB_VERSION=6.0

# Elasticsearch version
# Note: Elasticsearch is required for Gravitee APIM to function properly
# We use minimal heap settings (256MB) to reduce resource consumption
ELASTIC_VERSION=8.17.2
